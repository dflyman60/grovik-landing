---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Have a question about Grovik or one of our products?">
  <header class="page-intro">
    <div class="wrap copy-page">
      <h1>Contact</h1>
      <p>Have a question about Grovik or one of our products?</p>
      <p>We'd be happy to hear from you.</p>
      <p class="contact-email">
        <a class="text-link" href="mailto:contact@grovik.co">contact@grovik.co</a>
      </p>
      <p>For product inquiries, general questions, or support, reach out using the email address above.</p>
    </div>
  </header>
</BaseLayout>
