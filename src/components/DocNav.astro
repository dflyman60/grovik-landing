---
interface Section {
  id: string;
  label: string;
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
---

<nav class="doc-nav" data-doc-nav aria-label="On this page">
  <p class="doc-nav-label">On this page</p>
  <details class="doc-nav-details">
    <summary class="doc-nav-summary">On this page</summary>
    <ol>
      {
        sections.map((section) => (
          <li>
            <a href={`#${section.id}`}>{section.label}</a>
          </li>
        ))
      }
    </ol>
  </details>
</nav>

<script>
  const nav = document.querySelector("[data-doc-nav]");
  const details = nav?.querySelector("details");
  if (nav && details) {
    const desktop = window.matchMedia("(min-width: 64rem)");
    const links = [...nav.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
    const pairs = links.flatMap((link) => {
      const id = link.getAttribute("href")?.slice(1);
      const section = id ? document.getElementById(id) : null;
      return section ? [{ link, section }] : [];
    });

    const setCurrent = (id: string | null) => {
      for (const pair of pairs) {
        if (id && pair.section.id === id) pair.link.setAttribute("aria-current", "location");
        else pair.link.removeAttribute("aria-current");
      }
    };

    const sectionAtReadingLine = () => {
      const line = 112;
      let current = pairs[0]?.section.id ?? null;
      for (const pair of pairs) {
        if (pair.section.getBoundingClientRect().top <= line) current = pair.section.id;
      }
      return current;
    };

    const syncLayout = () => {
      if (desktop.matches) details.open = true;
      else details.open = false;
    };

    let frame = 0;
    const onScroll = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => setCurrent(sectionAtReadingLine()));
    };

    for (const pair of pairs) {
      pair.link.addEventListener("click", (event) => {
        setCurrent(pair.section.id);
        if (desktop.matches) return;
        event.preventDefault();
        details.open = false;
        const href = pair.link.getAttribute("href");
        if (href) history.pushState(null, "", href);
        pair.section.scrollIntoView();
      });
    }

    syncLayout();
    setCurrent(sectionAtReadingLine());
    desktop.addEventListener("change", () => {
      syncLayout();
      setCurrent(sectionAtReadingLine());
    });
    window.addEventListener("hashchange", () => {
      const id = location.hash.replace(/^#/, "");
      if (pairs.some((pair) => pair.section.id === id)) setCurrent(id);
    });
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
